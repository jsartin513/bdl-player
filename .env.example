# --- Non-secret (safe to set in Vercel for Preview / Production) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LEAGUE_CATALOG_URL=https://admin-preview.bostondodgeballleague.com/api/public/leagues
NEXT_PUBLIC_VERCEL_ENV=development

# --- Secrets (local: .env.local only; Preview / Production: Vercel dashboard) ---
# Google OAuth: dedicated Web client for play / play-preview — NOT admin ADMIN_GOOGLE_*.
# Redirect URIs: docs/KICKOFF_MANUAL.md § Google OAuth.
PLAYER_GOOGLE_CLIENT_ID=
PLAYER_GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret for player_session cookie signing.
PLAYER_SESSION_SECRET=
# Neon connection string for player app only (not admin DATABASE_URL).
PLAYER_DATABASE_URL=
# Shared with admin pull client; header X-BDL-Player-Sync-Secret (player + admin Vercel).
PLAYER_SYNC_SECRET=
# Optional until Sentry project exists.
SENTRY_DSN=
# Stage 3+ payments / email (optional until checkout is enabled).
# TODO(secret): STRIPE_SECRET_KEY — Stripe Dashboard → API keys (preview: test mode sk_test_…).
STRIPE_SECRET_KEY=
# TODO(secret): STRIPE_WEBHOOK_SECRET — Stripe Dashboard → Webhooks → signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
